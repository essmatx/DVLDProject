<!-- WPF generates 1 visual card for EVERY object in your C# List automatically -->
<ItemsControl ItemsSource="{Binding DashboardMetrics}">
	<ItemsControl.ItemTemplate>
		<DataTemplate>
			<Border Background="#191C1D" BorderBrush="{Binding AccentColor}" BorderThickness="1" CornerRadius="12" Margin="8">
				<StackPanel Padding="16">
					<TextBlock Text="{Binding Title}" Foreground="Gray" FontWeight="Bold"/>
					<TextBlock Text="{Binding Value}" Foreground="White" FontSize="24" FontFamily="Georgia"/>
				</StackPanel>
			</Border>
		</DataTemplate>
	</ItemsControl.ItemTemplate>
</ItemsControl>